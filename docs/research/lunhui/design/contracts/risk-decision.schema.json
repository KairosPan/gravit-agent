{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunhui.invalid/contracts/risk-decision.schema.json",
  "title": "risk-decision",
  "description": "Proposed design contract; not an implemented trading interface.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "risk_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "intent_id": {
      "type": "string",
      "minLength": 1
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": [
        "ALLOW",
        "REJECT",
        "DEFERRED"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "detail"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "permit": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "permit_id": {
              "type": "string",
              "minLength": 1
            },
            "reservation_id": {
              "type": "string",
              "minLength": 1
            },
            "bound_intent_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "account_ref": {
              "type": "string",
              "minLength": 1
            },
            "account_version": {
              "type": "string",
              "minLength": 1
            },
            "market_rules_version": {
              "type": "string",
              "minLength": 1
            },
            "symbol": {
              "type": "string",
              "minLength": 1
            },
            "side": {
              "enum": [
                "BUY",
                "SELL"
              ]
            },
            "max_quantity": {
              "type": "integer",
              "minimum": 1
            },
            "limit_price_min": {
              "type": "string",
              "pattern": "^(?:0\\.(?:0[1-9]|[1-9][0-9])|[1-9][0-9]*\\.[0-9]{2})$"
            },
            "limit_price_max": {
              "type": "string",
              "pattern": "^(?:0\\.(?:0[1-9]|[1-9][0-9])|[1-9][0-9]*\\.[0-9]{2})$"
            },
            "reserved_cash_minor": {
              "type": "integer",
              "minimum": 0
            },
            "reserved_sell_quantity": {
              "type": "integer",
              "minimum": 0
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            },
            "nonce": {
              "type": "string",
              "minLength": 1
            },
            "decision_snapshot_id": {
              "type": "string",
              "minLength": 1
            },
            "task_revision": {
              "type": "integer",
              "minimum": 1
            },
            "bound_decision_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "permit_id",
            "reservation_id",
            "bound_intent_hash",
            "account_ref",
            "account_version",
            "market_rules_version",
            "symbol",
            "side",
            "max_quantity",
            "limit_price_min",
            "limit_price_max",
            "reserved_cash_minor",
            "reserved_sell_quantity",
            "expires_at",
            "nonce",
            "decision_snapshot_id",
            "task_revision",
            "bound_decision_hash"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "side": {
                    "const": "BUY"
                  }
                }
              },
              "then": {
                "properties": {
                  "reserved_cash_minor": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "reserved_sell_quantity": {
                    "const": 0
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "side": {
                    "const": "SELL"
                  }
                }
              },
              "then": {
                "properties": {
                  "reserved_sell_quantity": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "risk_decision_id",
    "decision_id",
    "intent_id",
    "checked_at",
    "policy_version",
    "verdict",
    "reasons",
    "permit"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "ALLOW"
          }
        }
      },
      "then": {
        "properties": {
          "permit": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "enum": [
              "REJECT",
              "DEFERRED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "permit": {
            "type": "null"
          }
        }
      }
    }
  ]
}
