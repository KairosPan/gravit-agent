# macOS junk
.DS_Store
._*

# Claude Code local settings (keep shared config, ignore personal/local)
.claude/settings.local.json
.mcp.json

# SDD workspaces (ledgers, briefs, review packages — scratch, never committed)
.superpowers/

# Secrets / local credentials — NEVER commit (LLM keys and any provider's)
.env
.env.*
*.env

# scratch / run artifacts (CLAUDE.md §7)
decisions/
deck.png
.playwright-mcp/
.codex/

# face bot smoke roots: a real bots/ root must sit two levels above
# face/plugins/ for the SHIPPED relative plugin path to resolve, so the smoke
# mkdtemps one here and removes it (face/tests/bots-fixture.ts).
.bots-smoke-*

# The operator's design documents stay on this machine, off the public repository (2026-11-09):
# the charter, the as-built reference, the roadmap, the docs-and-prompt-loops page, and
# docs/superpowers/ (the specs, plans and runbooks, the previous product's 2026-06/07 history
# among them). Read and edit them in the primary checkout; never `git add -f` them.
/Gravit-Design.md
/DEVELOPMENT.md
/ROADMAP.md
/Gravit-Docs-and-Prompt-Loops.html
/docs/superpowers/
# the operator's machine-local instruction overlay for dsh agents (GRAVIT.md's twin);
# anchored to the root: a nested one would load into a channel's sessions yet hide from git
/GRAVIT.local.md
# the desk (B4): the operator's levels and holdings, and the strategies' pre-market reports, stay on this
# machine; desk/journal/ is the desk session's cwd, tracked by its .gitkeep alone; face/tests/tmp/ holds the smokes' fixtures
/desk/levels.yml
/desk/holdings.yml
/desk/journal/*
!/desk/journal/.gitkeep
/strategies/*/levels.yml
/strategies/*/reports/
/face/tests/tmp/

# the Lunhui corpus and the runs' evidence files stay out of the public repository (spec 2026-10-25 A26, D11)
/docs/research/lunhui/corpus/
strategies/*/analysis/*/evidence-*.json
# and a run write's crash leftovers: its staging files (residual R39)
strategies/*/analysis/*/*.pending.json
strategies/*/analysis/*/*.tmp
